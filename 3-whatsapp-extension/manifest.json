{
  "manifest_version": 3,
  "name": "S-ELEVEN WhatsApp Helper",
  "version": "1.0.0",
  "description": "Lets the S-ELEVEN portal open chats in the WhatsApp Web tab you already have open and signed in, instead of opening a new tab each time.",
  "permissions": ["tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://s-eleven.com/*", "https://*.s-eleven.com/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
