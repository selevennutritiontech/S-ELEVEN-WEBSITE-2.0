# Copy to .env and fill in. Never commit .env. Generate secrets with:  openssl rand -hex 32
DB_PASSWORD=change-me-long-random
APP_SECRET_KEY=64-hex-characters-from-openssl-rand-hex-32
# Needed ONLY on the very first start: the Host (ADMIN) password, at least 10 characters. Remove it from .env afterwards.
INITIAL_ADMIN_PASSWORD=
# The private address of the employee login (nothing on the website links to it; give it only to employees). Change it to something only you know,
# e.g. /access/staff-7k3m9x  (lower-case letters, digits, dashes). If it ever leaks, change it here and restart.
STAFF_PATH=/access/employee-server
