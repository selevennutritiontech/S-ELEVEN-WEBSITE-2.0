{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/backend/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/employee/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dealer-portal/admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/access/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dealer-portal",
      "destination": "https://s-eleven-website-2-0.onrender.com/dealer-portal/"
    },
    {
      "source": "/dealer-portal/:path*",
      "destination": "https://s-eleven-website-2-0.onrender.com/dealer-portal/:path*"
    },
    {
      "source": "/bot-pilot/:path*",
      "destination": "https://s-eleven-website-2-0.onrender.com/bot-pilot/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://s-eleven-website-2-0.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
